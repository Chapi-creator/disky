{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "disky",
  "version": "0.2.0",
  "identifier": "com.breiner.disky",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "disky",
        "width": 800,
        "height": 600,
        "backgroundColor": "#06080b"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data:",
        "style-src": "'unsafe-inline' 'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2QzhFNzk3RkIzNjg5QjUKUldTMWlUYjdsK2ZJdHFhcjEyTWxPbGJGNENOcnlJSm9kQzlNTkpWTEdIL3VQQTlpSjhwUkRMQlgK",
      "endpoints": [
        "https://github.com/Chapi-creator/disky/releases/latest/download/latest.json"
      ]
    }
  }
}
